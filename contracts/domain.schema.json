{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "山地驿站共益运营领域事件",
  "description": "用于跨模块交换事实记录的公共信封。信封只固定公共字段；各事件类型的聚合绑定与 payload 必备字段见 src/events.py。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识；来源系统重试时必须沿用原标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSET_REGISTERED",
        "CAPACITY_DECLARED",
        "EQUIPMENT_INSTALLED",
        "EQUIPMENT_REMOVED",
        "WORK_ORDER_OPENED",
        "WORK_ORDER_CLOSED",
        "SERVICE_SUSPENDED",
        "SERVICE_RESUMED",
        "TERM_GRANTED",
        "TERM_RENEWED",
        "TERM_EXPIRED",
        "TERM_VACATED",
        "EXIT_REQUESTED",
        "EXIT_ITEM_CLEARED",
        "OPERATOR_EXITED",
        "SERVICE_RECORDED",
        "CONTRIBUTION_RECORDED",
        "CONSIGNMENT_STOCKED",
        "CONSIGNMENT_SOLD",
        "CONSIGNMENT_RETURNED",
        "BAD_DEBT_RECORDED",
        "DISCLOSURE_PUBLISHED",
        "BENEFIT_ALLOCATED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "shared_asset",
        "operating_term",
        "community_contribution",
        "benefit_distribution"
      ],
      "description": "业务对象类型（跨村交换边界，不得新增）"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本，从 1 开始递增"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "业务内容，必备字段按事件类型见 src/events.py"
    }
  },
  "additionalProperties": true
}
