        "village",
        "season",
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "site_asset_id": {
          "type": "string"
        },
        "party_id": {
          "type": "string"
        },
        "village": {
          "type": "string"
        },
        "season": {
          "type": "string"
        },
        "starts_at": {
          "type": "string"
        },
        "ends_at": {
          "type": "string"
        }
      },
