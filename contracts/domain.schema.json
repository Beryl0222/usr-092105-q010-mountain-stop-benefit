{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "百里画廊沿线共益运营领域事件",
  "description": "用于跨村、跨机构交换事实记录的公共信封。事件由 event_id 唯一标识，aggregate_id 指向业务对象，version 从 1 开始递增，occurred_at 保留真实发生时间；来源系统重试时必须沿用原事件标识。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "ASSET_REGISTERED",
        "ASSET_USAGE_RECORDED",
        "ASSET_RETURNED",
        "ASSET_REMOVED",
        "TERM_GRANTED",
        "TERM_EXPIRED",
        "TERM_REVOKED",
        "PREPAYMENT_RECEIVED",
        "PREPAYMENT_FULFILLED",
        "PREPAYMENT_REFUNDED",
        "OPERATOR_EXITED",
        "SERVICE_RECORDED",
        "BENEFIT_ALLOCATED",
        "BENEFIT_SETTLED",
        "STALL_PERMIT_ISSUED",
        "STALL_CLOSED",
        "CONSIGNMENT_DELIVERED",
        "CONSIGNMENT_SOLD",
        "CONSIGNMENT_RETURNED",
        "CONSIGNMENT_BAD_DEBT",
        "CONSIGNMENT_SETTLED",
        "REFERRAL_RECORDED",
        "REFERRAL_VERIFIED",
        "REFERRAL_REJECTED",
        "SHIFT_SCHEDULED",
        "SHIFT_FULFILLED",
        "SHIFT_CANCELLED",
        "PLEDGE_MADE",
        "PLEDGE_FULFILLED",
        "PLEDGE_SHORTFALL",
        "CAPACITY_DEFINED",
        "LOAD_REPORTED",
        "OVERLOAD_DECLARED",
        "OVERLOAD_CLEARED",
        "SUSPENSION_ISSUED",
        "SUSPENSION_LIFTED",
        "COMMITMENT_HONORED",
        "REPAIR_OPENED",
        "REPAIR_CLAIMED",
        "REPAIR_COMPLETED",
        "NOTICE_PUBLISHED",
        "HANDOVER_LIST_GENERATED",
        "HANDOVER_BLOCKER_RESOLVED",
        "HANDOVER_COMPLETED"
      ],
      "description": "本领域事件类型（见 src/catalog.py 事件目录）"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "shared_asset",
        "operating_term",
        "community_contribution",
        "benefit_distribution",
        "seasonal_stall",
        "consignment",
        "referral",
        "volunteer_shift",
        "employment_pledge",
        "eco_capacity",
        "suspension",
        "repair_order",
        "public_notice",
        "handover"
      ],
      "description": "业务对象类型；前四项为跨村交换边界：跨村交换边界：公共资产与道路节点；跨村交换边界：经营许可与期限；跨村交换边界：跨村贡献交换（须附证据）；跨村交换边界：收益分配结果"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "payload": {
      "type": "object",
      "description": "事件业务字段，结构随 event_type 而定"
    }
  },
  "$defs": {
    "payload_ASSET_REGISTERED": {
      "type": "object",
      "required": [
        "asset_kind",
        "village",
        "owner",
        "funded_by",
        "location_name",
        "maintenance_responsible_party"
      ],
      "properties": {
        "asset_kind": {
          "type": "string",
          "enum": [
            "road_node",
            "public_toilet",
            "public_facility",
            "collective_yard",
            "stall_site",
            "equipment"
          ]
        },
        "village": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "enum": [
            "collective",
            "government",
            "operator"
          ]
        },
        "funded_by": {
          "type": "string",
          "enum": [
            "fiscal",
            "collective",
            "social",
            "operator"
          ]
        },
        "location_name": {
          "type": "string"
        },
        "maintenance_responsible_party": {
          "type": "string"
        },
        "road_node_asset_id": {
          "type": "string"
        },
        "present_at_asset_id": {
          "type": "string"
        },
        "removable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "payload_ASSET_USAGE_RECORDED": {
      "type": "object",
      "required": [
        "asset_id",
        "term_id",
        "party_id",
        "used_from",
        "used_to",
        "usage_kind"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "term_id": {
          "type": "string"
        },
        "party_id": {
          "type": "string"
        },
        "used_from": {
          "type": "string"
        },
        "used_to": {
          "type": "string"
        },
        "usage_kind": {
          "type": "string",
          "enum": [
            "cafe",
            "homestay",
            "stall",
            "storage",
            "service",
            "other"
          ]
        }
      },
      "additionalProperties": true
    },
    "payload_ASSET_RETURNED": {
      "type": "object",
      "required": [
        "asset_id",
        "term_id",
        "returned_by",
        "condition_note"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "term_id": {
          "type": "string"
        },
        "returned_by": {
          "type": "string"
        },
        "condition_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload_ASSET_REMOVED": {
      "type": "object",
      "required": [
        "asset_id",
        "removing_party",
        "reason"
      ],
      "properties": {
        "asset_id": {
          "type": "string"
        },
        "removing_party": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload_TERM_GRANTED": {
      "type": "object",
      "required": [
        "party_id",
        "village",
        "scope",
        "asset_ids",
        "starts_at",
        "ends_at",
        "seasonal",
        "grant_basis"
      ],
      "properties": {
        "party_id": {
          "type": "string"
        },
        "village": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "station_cafe",
            "homestay",
            "facility_operation",
            "collective_yard"
          ]
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "starts_at": {
          "type": "string"
        },
        "ends_at": {
          "type": "string"
        },
        "seasonal": {
          "type": "boolean"
        },
        "grant_basis": {
          "type": "string",
          "enum": [
            "open_bid",
            "rotation",
            "direct"
          ]
        },
        "conditions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "payload_TERM_EXPIRED": {
      "type": "object",
      "required": [],
      "properties": {
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload_TERM_REVOKED": {
      "type": "object",
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload_PREPAYMENT_RECEIVED": {
