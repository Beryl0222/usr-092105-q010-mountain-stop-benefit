        "village",
        "items_summary",
        "quantity",
        "unit",
        "unit_price_cents",
        "unsold_policy",
        "delivered_at"
      ],
      "properties": {
        "term_id": {
          "type": "string"
        },
        "supplier_party_id": {
          "type": "string"
        },
        "seller_party_id": {
          "type": "string"
        },
        "village": {
          "type": "string"
        },
        "items_summary": {
